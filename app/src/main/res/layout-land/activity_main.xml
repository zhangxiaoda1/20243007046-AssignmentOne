<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape layout: banner on top, the four image buttons in a single row.
     All view IDs match the portrait layout so the same Java code applies. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Banner takes enough height for three lines of 40sp text -->
    <FrameLayout
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3">

        <ImageView
            android:id="@+id/banner_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/banner_content_description"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <!-- 40sp is the only hard-coded text size allowed by the specification -->
        <TextView
            android:id="@+id/banner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:shadowColor="@color/banner_text_shadow"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/banner_welcome_land"
            android:textColor="@color/white"
            android:textSize="40sp" />
    </FrameLayout>

    <!-- Button row takes the remaining height; four equal columns -->
    <GridLayout
        android:id="@+id/button_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.7"
        android:columnCount="4"
        android:rowCount="1">

        <!-- Facilities -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:background="@color/green"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_facilities"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/label_facilities"
                android:padding="@dimen/button_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_facilities" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="@dimen/button_label_padding_bottom"
                android:text="@string/label_facilities"
                android:textColor="@color/white"
                android:textSize="@dimen/button_label_text_size" />
        </LinearLayout>

        <!-- Events -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:background="@color/green"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_events"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/label_events"
                android:padding="@dimen/button_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_events" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="@dimen/button_label_padding_bottom"
                android:text="@string/label_events"
                android:textColor="@color/white"
                android:textSize="@dimen/button_label_text_size" />
        </LinearLayout>

        <!-- Clubs -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:background="@color/green"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_clubs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/label_clubs"
                android:padding="@dimen/button_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_clubs" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="@dimen/button_label_padding_bottom"
                android:text="@string/label_clubs"
                android:textColor="@color/white"
                android:textSize="@dimen/button_label_text_size" />
        </LinearLayout>

        <!-- Support -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_columnWeight="1"
            android:background="@color/green"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_support"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/label_support"
                android:padding="@dimen/button_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_support" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="@dimen/button_label_padding_bottom"
                android:text="@string/label_support"
                android:textColor="@color/white"
                android:textSize="@dimen/button_label_text_size" />
        </LinearLayout>
    </GridLayout>
</LinearLayout>
